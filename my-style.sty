\NewDocumentCommand{\dauchamC}{m O{1} O{0.5mm}}{%
	% #1 = số dòng; #2 = số cột-con; #3 = gap
	\vspace{0.9em}\par\noindent
	\begin{tikzpicture}[baseline=(base), inner sep=0pt, outer sep=0pt]
		\coordinate (base) at (0,0);
		\pgfmathsetlengthmacro{\colw}{\dimexpr\linewidth/#2\relax}
		\pgfmathsetlengthmacro{\gap}{#3}
		\pgfmathsetlengthmacro{\eps}{0.2pt}
		
		% TĂNG KHOẢNG CÁCH DÒNG TẠI ĐÂY (Thay 1.9em bằng 2.5em hoặc tùy ý)
		\pgfmathsetlengthmacro{\lineheight}{2.5em} 
		
		% Vẽ các dòng kẻ chấm
		\foreach \i in {1,...,#1}{
			\pgfmathsetlengthmacro{\yoffset}{-(\i-1)*\lineheight}
			\foreach \j in {1,...,#2}{
				\pgfmathsetlengthmacro{\L}{(\j-1)*\colw}
				\pgfmathsetlengthmacro{\R}{\j*\colw}
				\ifnum\j=1 \pgfmathsetlengthmacro{\start}{\L} \else \pgfmathsetlengthmacro{\start}{\L + 0.5*\gap} \fi
				\ifnum\j=#2 \pgfmathsetlengthmacro{\endd}{\R} \else \pgfmathsetlengthmacro{\endd}{\R - 0.5*\gap} \fi
				
				\draw[dotted, line width=0.4pt] (\start,\yoffset) -- (\endd - \eps, \yoffset);
			}
		}
		
		% VẼ ĐƯỜNG CHIA GIỮA (NÉT LIỀN)
		\ifnum#2>1
		\foreach \j in {1,...,\numexpr#2-1\relax}{
			\pgfmathsetlengthmacro{\xmid}{\j*\colw}
			% Đường dọc bắt đầu từ phía trên dòng 1 một chút và kết thúc tại dòng cuối
			\draw[solid, line width=0.3pt] (\xmid, 1.2ex) -- (\xmid, -#1*\lineheight + \lineheight);
		}
		\fi
	\end{tikzpicture}
	\vspace{0.7em}\par
}

\NewDocumentCommand{\dauchamK}{m O{1} O{0.5mm}}{%
	\vspace{1.3em}\foreach \i in {1,...,#1}{%
		\par\noindent
		\begin{tikzpicture}[baseline=(base)]
			\coordinate (base) at (0,0);
			\path[use as bounding box] (0,-1.2ex) rectangle (\linewidth,1.2ex);
			\pgfmathsetlengthmacro{\colw}{\dimexpr\linewidth/#2\relax}
			\pgfmathsetlengthmacro{\gap}{#3}
			\pgfmathsetlengthmacro{\eps}{0.2pt}
			\foreach \j in {1,...,#2}{
				\pgfmathsetlengthmacro{\L}{(\j-1)*\colw}
				\pgfmathsetlengthmacro{\R}{\j*\colw}
				\ifnum\j=1
				\pgfmathsetlengthmacro{\start}{\L}
				\else
				\pgfmathsetlengthmacro{\start}{\L+0.5*\gap}
				\fi
				\ifnum\j=#2
				\pgfmathsetlengthmacro{\endd}{\R}
				\else
				\pgfmathsetlengthmacro{\endd}{\R-0.5*\gap}
				\fi
				\pgfmathsetlengthmacro{\startadj}{\start}
				\pgfmathsetlengthmacro{\endadj}{\endd-\eps}
				\draw[dotted,line width=0.7pt] (\startadj,0)--(\endadj,0);
			}
		\end{tikzpicture}\par\vspace{1.1em}
	}
}

