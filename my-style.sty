% --- Bộ đếm phụ ---
\newcounter{itemCount}

% =========================================================
% ====== MÔ-ĐUN CÂU TỰ LUẬN MỞ RỘNG (CAUNN) ===============
% =========================================================
% Cách dùng:
%   \cauNN[<số cột>][<số dòng dấu chấm>]{<đề bài>}{<danh sách biểu thức cách nhau dấu phẩy>}
% ---------------------------------------------------------

\NewDocumentCommand{\cauN}{O{2} O{3} m m}{%
	\cau{#3}% --- in phần đề bài ---
	\setcounter{itemCount}{0}% reset bộ đếm
	\begingroup
	\def\cols{#1}% số cột (2, 3, 4)
	\def\lines{#2}% số dòng dấu chấm (tùy chọn)
	\def\groupOpen{0}% cờ báo nhóm đang mở
	
	% --- Tự động chọn môi trường phù hợp ---
	\def\beginEnv{%
		\ifnum\cols=1 \begin{tuluan}%
			\else\ifnum\cols=2 \begin{tuluan2}%
				\else\ifnum\cols=3 \begin{tuluan3}%
					\else\ifnum\cols=4 \begin{tuluan4}%
						\fi\fi\fi\fi
					}%
					\def\endEnv{%
						\ifnum\cols=1 \end{tuluan}%
					\else\ifnum\cols=2 \end{tuluan2}%
				\else\ifnum\cols=3 \end{tuluan3}%
			\else\ifnum\cols=4 \end{tuluan4}%
		\fi\fi\fi\fi
	}%
	
	% --- Lặp qua từng ý ---
	\renewcommand{\do}[1]{%
		\stepcounter{itemCount}%
		\ifnum\groupOpen=0
		\beginEnv%
		\addtocounter{enumi}{\value{itemCount}-1}%
		\fi
		\item ##1%
		\pgfmathtruncatemacro{\modres}{mod(\value{itemCount},\cols)}%
		\ifnum\modres=0
		\endEnv%
		\dauchamK{\lines}[\cols][3mm]%
		\def\groupOpen{0}%
		\else
		\def\groupOpen{1}%
		\fi
	}%
	
	% --- Đọc danh sách biểu thức ---
	\docsvlist{#4}%
	
	% --- Kết nhóm nếu còn dở ---
	\ifnum\groupOpen=1
	\endEnv%
	\dauchamK{\lines}[\cols][3mm]%
	\fi
	\endgroup
}


%% =========================================================
%% ========== XIV. BIỂU ĐỒ & HƯỚNG DẪN SỬ DỤNG ============
%% =========================================================
%%
%% Các môi trường biểu đồ được thiết kế bằng TikZ + PGFPlots.
%% Có thể dùng để minh họa số liệu thống kê, bài toán thực tế, v.v.
%%
%%==========================================================
%% BIỂU ĐỒ HÌNH QUẠT TRÒN MÀU PASTEL
%%==========================================================
%% Cách dùng:
%%
%% \myPatternPie[<bán kính>]{
	%%     <tỉ lệ>/<chú thích>,
	%%     <tỉ lệ>/<chú thích>,
	%%     ...
	%% }
%%
%% Ví dụ:
%%
%% \myPatternPie[1.6]{
	%%     50/Nửa hình tròn,
	%%     25/Một phần tư,
	%%     25/Một phần tư
	%% }
%%==========================================================

%----------------------------------------------------------
% BẢNG MÀU PASTEL
%----------------------------------------------------------
%==========================================================
% BẢNG MÀU TƯƠI, ĐỒNG BỘ VỚI TOÀN BỘ BÀI
%==========================================================
\definecolor{pieColorOne}{RGB}{255,170,178}   % hồng san hô
\definecolor{pieColorTwo}{RGB}{149,203,255}   % xanh da trời
\definecolor{pieColorThree}{RGB}{164,226,165} % xanh lá non
\definecolor{pieColorFour}{RGB}{255,205,130}  % cam kem
\definecolor{pieColorFive}{RGB}{213,176,255}  % tím nhạt
\definecolor{pieColorSix}{RGB}{137,224,218}   % xanh ngọc
\definecolor{pieColorSeven}{RGB}{255,191,224} % hồng tím

\definecolor{pieBorder}{RGB}{95,95,95}
\definecolor{pieText}{RGB}{55,55,55}

\newcount\patternpieN

\newcommand{\myPatternPie}[2][1.6]{%
	\begingroup
	
	% Bán kính hình tròn
	\def\R{#1}%
	
	% Đếm số phần dữ liệu
	\patternpieN=0
	\foreach \entry in {#2}{%
		\global\advance\patternpieN by 1
	}%
	
	% Góc bắt đầu
	\def\startangle{90}%
	
	\begin{tikzpicture}[
		font=\scriptsize,
		line cap=round,
		line join=round
		]
		
		%==================================================
		% VẼ CÁC HÌNH QUẠT
		%==================================================
		\foreach[count=\i from 1] \p/\name in {#2}{
			
			%------------------------------------------------
			% Chọn màu
			%------------------------------------------------
			\pgfmathtruncatemacro{\colorindex}{
				mod(\i-1,7)+1
			}
			
			\ifcase\colorindex\relax
			\or
			\def\mycolor{pieColorOne}
			\or
			\def\mycolor{pieColorTwo}
			\or
			\def\mycolor{pieColorThree}
			\or
			\def\mycolor{pieColorFour}
			\or
			\def\mycolor{pieColorFive}
			\or
			\def\mycolor{pieColorSix}
			\else
			\def\mycolor{pieColorSeven}
			\fi
			
			%------------------------------------------------
			% Tính góc
			%------------------------------------------------
			\pgfmathsetmacro{\delta}{\p*3.6}
			\pgfmathsetmacro{\endangle}{
				\startangle-\delta
			}
			\pgfmathsetmacro{\midangle}{
				\startangle-0.5*\delta
			}
			
			%------------------------------------------------
			% Vẽ hình quạt
			%------------------------------------------------
			\filldraw[
			fill=\mycolor,
			draw=pieBorder,
			line width=0.6pt
			]
			(0,0)
			--(\startangle:\R)
			arc[
			start angle=\startangle,
			end angle=\endangle,
			radius=\R
			]
			--cycle;
			
			%------------------------------------------------
			% Ghi phần trăm
			%------------------------------------------------
			\node[
			font=\bfseries,
			text=pieText,
			fill=white,
			fill opacity=0.72,
			text opacity=1,
			inner sep=1.2pt,
			rounded corners=1.2pt
			]
			at (\midangle:0.62*\R)
			{\p\%};
			
			% Cập nhật góc bắt đầu
			\xdef\startangle{\endangle}
		}
		
		%==================================================
		% VIỀN NGOÀI
		%==================================================
		\draw[
		draw=pieBorder,
		line width=0.8pt
		]
		(0,0) circle (\R);
		
		%==================================================
		% CHÚ THÍCH
		%==================================================
		\begin{scope}[xshift=1.22*\R cm]
			
			\def\s{0.34}
			\pgfmathsetmacro{\gap}{0.58}
			\pgfmathsetmacro{\starty}{
				(\number\patternpieN-1)*\gap/2
			}
			
			\node[
			anchor=west,
			font=\bfseries\small ,
			text=pieText
			]
			at (0,\starty+\gap+0.3)
			{Chú thích};
			
			\foreach[count=\j from 1] \p/\name in {#2}{
				
				%--------------------------------------------
				% Chọn màu tương ứng
				%--------------------------------------------
				\pgfmathtruncatemacro{\colorindex}{
					mod(\j-1,7)+1
				}
				
				\ifcase\colorindex\relax
				\or
				\def\mycolorLegend{pieColorOne}
				\or
				\def\mycolorLegend{pieColorTwo}
				\or
				\def\mycolorLegend{pieColorThree}
				\or
				\def\mycolorLegend{pieColorFour}
				\or
				\def\mycolorLegend{pieColorFive}
				\or
				\def\mycolorLegend{pieColorSix}
				\else
				\def\mycolorLegend{pieColorSeven}
				\fi
				
				\pgfmathsetmacro{\y}{
					\starty-(\j-1)*\gap
				}
				
				% Ô màu
				\filldraw[
				fill=\mycolorLegend,
				draw=pieBorder,
				line width=0.45pt
				]
				(0,\y)
				rectangle ++(\s,\s);
				
				% Nội dung chú thích
				\node[
				anchor=west,
				text=pieText,
				font=\footnotesize ,
				text width=5cm,
				align=left
				]
				at (\s+0.14,\y+0.5*\s)
				{\name};
			}
		\end{scope}
		
	\end{tikzpicture}
	
	\endgroup
}

%% ---------------------------------------------------------
%% 2️⃣ BIỂU ĐỒ CỘT — \bieudocot
%% ---------------------------------------------------------
%% Cách dùng:
%%   \bieudocot{Danh mục}{Giá trị1,Giá trị2,...}
%%   \bieudocot{Lớp}{35,40,28,50}
%%
%% Sẽ tự động sinh cột với độ cao tương ứng, nhãn bên dưới.
%% ---------------------------------------------------------

\newcommand{\bieudocot}[2][1]{%
\begin{tikzpicture}[x=1.5cm,y=0.7cm,scale=#1]
	% ==== TRỤC TUNG ====
	\draw[->] (0,0) -- (0,9);
	\node[rotate=0,anchor=east,scale=0.7] at (2,9.5) {\small Số học sinh};
	% ==== VẠCH CHIA ====
	\foreach \y in {0,1,...,8}
	\draw (-0.1,\y) -- (0.1,\y) node[left=4pt,scale=0.75]{\small \y};
	\draw (0,0) -- (7.5,0);
	
	% ==== VẼ CÁC CỘT ====
	\foreach \x/\h/\lbl in {#2}{%
		\draw[fill=blue,draw=black] (\x,0) rectangle ++(0.8,\h);
		\node[above,scale=0.75] at (\x+0.4,\h) {\small \h};
		\node[below,scale=0.6,text depth=1.5pt] at (\x+0.4,0) {\text{\lbl}};
	}
\end{tikzpicture}%
}

%% ---------------------------------------------------------
%% 3️⃣ BIỂU ĐỒ CỘT KÉP — \bieudocotkep
%% ---------------------------------------------------------
%% Dùng để so sánh 2 nhóm dữ liệu (VD: Nam / Nữ, Trước / Sau,...)
%%
%% Cách dùng:
%%   \bieudocotkep{Danh mục}{Dữ liệu1}{Dữ liệu2}{Tên1}{Tên2}
%%
%% Ví dụ:
%%{\centering
%%	\bieudocotkep{Bóng đá}{12}{10}{Bóng rổ}{5}{6}{Cầu lông}{8}{7}
%%	\par}}
%%
%% ---------------------------------------------------------

\newcommand{\bieudocotkep}[9]{%
\begin{center}
\begin{tikzpicture}[scale=0.6,font=\small]
	% ==== TRỤC TUNG ====
	\draw[->] (0,0) -- (0,6.5) node[above right] {Số học sinh};
	\foreach \y in {0,2,4,6,8,10,12}{
		\draw (-0.08,\y/2) -- (0.08,\y/2);
		\node[left] at (-0.12,\y/2) {\y};
	}
	% ==== ĐƯỜNG ĐÁY ====
	\draw[thick] (0,0) -- (7.8,0);
	% ==== KHOẢNG CÁCH & CHIỀU RỘNG CỘT ====
	\def\xsep{2.2}
	\def\w{0.35}
	
	% --- Nhóm 1 ---
	\draw[fill=blue] (1*\xsep-\w,0) rectangle ++(2*\w,#2/2);
	\node[above,font=\scriptsize] at (1*\xsep,#2/2) {#2};
	
	\draw[draw=black,fill=white] (1*\xsep+\w,0) rectangle ++(2*\w,#3/2);
	\node[above,font=\scriptsize] at (1*\xsep+2*\w,#3/2) {#3};
	
	% --- Nhóm 2 ---
	\draw[fill=blue] (2*\xsep-\w,0) rectangle ++(2*\w,#5/2);
	\node[above,font=\scriptsize] at (2*\xsep,#5/2) {#5};
	
	\draw[draw=black,fill=white] (2*\xsep+\w,0) rectangle ++(2*\w,#6/2);
	\node[above,font=\scriptsize] at (2*\xsep+2*\w,#6/2) {#6};
	
	% --- Nhóm 3 ---
	\draw[fill=blue] (3*\xsep-\w,0) rectangle ++(2*\w,#8/2);
	\node[above,font=\scriptsize] at (3*\xsep,#8/2) {#8};
	
	\draw[draw=black,fill=white] (3*\xsep+\w,0) rectangle ++(2*\w,#9/2);
	\node[above,font=\scriptsize] at (3*\xsep+2*\w,#9/2) {#9};
	
	% ==== NHÃN NHÓM ====
	\node[below,scale=0.85] at (1*\xsep+1*\w,0) {\text{#1}};
	\node[below,scale=0.85] at (2*\xsep+1*\w,0) {\text{#4}};
	\node[below,scale=0.85] at (3*\xsep+1*\w,0) {\text{#7}};
	
	% ==== CHÚ THÍCH ====
	\draw[fill=blue] (7.2,5.8) rectangle ++(0.35,0.35);
	\node[right] at (7.6,6.0) {Nam};
	\draw[draw=black,fill=white] (7.2,5.0) rectangle ++(0.35,0.35);
	\node[right] at (7.6,5.2) {Nữ};
\end{tikzpicture}
\end{center}
}

