% =========================================================
% \baitinhchia{}{}: đặt phép chia dọc
% =========================================================
\newcommand{\baitinhchia}[2]{%
	\ensuremath{%
\begin{tikzpicture}[baseline={(A.base)}]
	% Số bị chia
	\node (A) at (0,0) {\(#1\)};
	% Số chia
	\node (B) at (1.8,0) {\(#2\)};
	
	% Trục chia: thanh dọc thứ 1 (|)
	\draw[line width=0.6pt] (1.2,0.4) -- (1.2,-1.6);
	
	% Thanh ngang: bắt đầu từ trục chia, dưới số chia
	\draw[line width=0.6pt] (1.2,-0.4) -- (3.0,-0.4);
	\end{tikzpicture}
}
}

% =========================================================
% \lapanh[kích cỡ ảnh]{link ảnh}{số hàng}{số cột}: lặp lại 1 ảnh m hàng và n cột
% =========================================================
\ExplSyntaxOn
\NewDocumentCommand{\lapanh}{ O{1.5cm} m m m }
{
	\begin{center}
		\int_zero:N \l_tmpa_int
		\int_step_inline:nn { #3 }
		{
			\int_step_inline:nn { #4 }
			{
				\parbox[c]{#1}{\centering\includegraphics[width=#1]{#2}}
				\int_incr:N \l_tmpa_int
				\int_compare:nNnT {##1} < {#4} { \hspace{6pt} }
			}
			\int_compare:nNnT {##1} < {#3} { \par\smallskip }
		}
	\end{center}
}


\ExplSyntaxOff

