\setlength{\headheight}{38pt}
\setlength{\footskip}{15pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

\RequirePackage{fancyhdr}
\RequirePackage{lastpage}

% --- Mẫu header/footer chính ---
\fancypagestyle{mainstyle}{
	\fancyhf{}
	\fancyhead[L]{\footnotesize\textcolor{eduheader}{\textit{Biên soạn: \dauchamn[19em]}}}
	\fancyhead[R]{\footnotesize\textcolor{eduheader}{\textit{TH–THCS}}}
	\fancyfoot[C]{\small\textcolor{eduheader}{Trang \thepage\ |\ \pageref{LastPage}}}
	\renewcommand{\headrule}{\vspace{-1.5ex}\makebox[\headwidth]{\color{eduline}\rule{\headwidth}{0.4pt}}}
	\renewcommand{\footrule}{\vspace{-0.5ex}\makebox[\headwidth]{\color{eduline}\rule{\headwidth}{0.4pt}}}
}

% --- Trang rỗng (bìa, chương mở đầu) ---
\fancypagestyle{plainempty}{
	\fancyhf{}
	\renewcommand{\headrulewidth}{0pt}
	\renewcommand{\footrulewidth}{0pt}
}

\AtBeginDocument{
	\fancypagestyle{chapterplain}{
		\fancyhf{}
		\renewcommand{\headrulewidth}{0pt}
		\renewcommand{\footrulewidth}{0pt}
	}
	\let\ps@plain\ps@chapterplain
}
% ĐỊNH NGHĨA KIỂU TRANG SGKSTYLE
% =============================================================================

% 1. Khai báo biến lưu mã giáo trình (Mặc định để trống)
\newcommand{\magiaotrinh}{}
% Lệnh để người dùng nhập mã ở file .tex
\newcommand{\setmagiaotrinh}[1]{\renewcommand{\magiaotrinh}{#1}}

% 2. Định nghĩa kiểu trang sgkstyle
\fancypagestyle{sgkstyle}{
	\fancyhf{}
	% Header trái: Tên người biên soạn (có dấu chấm lửng)
	\fancyhead[L]{\footnotesize\textcolor{eduheader}{\textit{Biên soạn: \dauchamn[19em]}}}
	% Header phải: Cấp học
	\fancyhead[R]{\footnotesize\textcolor{eduheader}{\textit{TH–THCS}}}
	
	% Footer giữa: Trang [số trang] | [mã giáo trình tự nhập]
	\fancyfoot[C]{\small\textcolor{eduheader}{Trang \thepage\ | \magiaotrinh}}
	
	% Đường kẻ Header và Footer
	\renewcommand{\headrule}{\vspace{-1.5ex}\makebox[\headwidth]{\color{eduline}\rule{\headwidth}{0.4pt}}}
	\renewcommand{\footrule}{\vspace{-0.5ex}\makebox[\headwidth]{\color{eduline}\rule{\headwidth}{0.4pt}}}
}

% 3. Cấu hình mặc định khi bắt đầu tài liệu
\AtBeginDocument{
	\fancypagestyle{chapterplain}{
		\fancyhf{}
		\renewcommand{\headrulewidth}{0pt}
		\renewcommand{\footrulewidth}{0pt}
	}
	\let\ps@plain\ps@chapterplain
	\pagestyle{sgkstyle} % Tự động áp dụng sgkstyle cho toàn bộ tài liệu
}

