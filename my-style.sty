\RequirePackage{titlesec}

% ----- Định dạng tiêu đề phần lớn (PART) -----
\titleformat{\part}[display]
{\centering\Huge\bfseries\color{partColor}}
{PHẦN \thepart}
{0.5em}
{\MakeUppercase}
[\vspace{0.8cm}\titlerule]

% ----- Tùy chỉnh hiển thị PART trong mục lục -----
\makeatletter
\renewcommand{\l@part}[2]{%
	\ifnum \c@tocdepth > -2\relax
	\addpenalty{-\@highpenalty}%
	\addvspace{2.25em \@plus\p@}%
	\begingroup
	\parindent \z@ \rightskip \@pnumwidth
	\parfillskip -\@pnumwidth
	\leavevmode
	{\Large\bfseries\color{partColor}%
		\textbf{\thepart\quad #1}\hfil\hb@xt@\@pnumwidth{\hss #2}}%
	\par\nobreak\vskip 1em
	\endgroup
	\fi}
\makeatother

% ----- Bảo đảm trang PART không có header/footer -----
\makeatletter
\apptocmd{\@endpart}{\thispagestyle{partpage}}{}{}
\makeatother


