\ExplSyntaxOn

\NewDocumentEnvironment{ykieu}{m}
{
	\str_case:nnF {#1}
	{
		{sao}        {\begin{dsSao}}
		{trangTri1}  {\begin{dsTrangTri1}}
		{trangTri2}  {\begin{dsTrangTri2}}
		{vong}       {\begin{dsVong}}
		{hand}       {\begin{dsHand}}
		{sun}        {\begin{dsSun}}
		{heart}      {\begin{dsHeart}}
		{leaf}       {\begin{dsLeaf}}
		{diamond}    {\begin{dsDiamond}}
		{arrowR}     {\begin{dsArrowR}}
		{bell}       {\begin{dsBell}}
		{book}       {\begin{dsBook}}
		{idea}       {\begin{dsIdea}}
		{warning}    {\begin{dsWarning}}
		{pencil}     {\begin{dsPencil}}
		{flower}     {\begin{dsFlower}}
		{fire}       {\begin{dsFire}}
		{flag}       {\begin{dsFlag}}
		{question}   {\begin{dsQuestion}}
	}
	{
		\PackageError{ykieu}
		{Kieu~'#1'~chua~duoc~dinh~nghia}
		{
			Hay~chon:~sao,~trangTri1,~trangTri2,~vong,~hand,~sun,~heart,
			leaf,~diamond,~arrowR,~bell,~book,~idea,~warning,~pencil,
			flower,~fire,~flag,~question.
		}
	}
}
{
	\str_case:nn {#1}
	{
		{sao}        {\end{dsSao}}
		{trangTri1}  {\end{dsTrangTri1}}
		{trangTri2}  {\end{dsTrangTri2}}
		{vong}       {\end{dsVong}}
		{hand}       {\end{dsHand}}
		{sun}        {\end{dsSun}}
		{heart}      {\end{dsHeart}}
		{leaf}       {\end{dsLeaf}}
		{diamond}    {\end{dsDiamond}}
		{arrowR}     {\end{dsArrowR}}
		{bell}       {\end{dsBell}}
		{book}       {\end{dsBook}}
		{idea}       {\end{dsIdea}}
		{warning}    {\end{dsWarning}}
		{pencil}     {\end{dsPencil}}
		{flower}     {\end{dsFlower}}
		{fire}       {\end{dsFire}}
		{flag}       {\end{dsFlag}}
		{question}   {\end{dsQuestion}}
	}
}

