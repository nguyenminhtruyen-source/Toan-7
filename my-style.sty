% ======= dấu chấm hết trang (phiên bản mới) =========
\makeatletter
\NewDocumentCommand{\dauchamE}{m}{%
  % #1 = số trang muốn phủ (1 = trang hiện tại,
  %                         2 = +1 trang,
  %                         3 = +2 trang,...)
  \par\noindent
  \begingroup

  % ==== TÍNH SỐ DÒNG CÒN LẠI TRANG HIỆN TẠI ====
  \dimen@=\pagegoal
  \advance\dimen@ by -\pagetotal
  \advance\dimen@ by -\footskip
  \advance\dimen@ by -0.7\baselineskip

  % 1 dòng dauchamK ≈ 2.4 baselineskip (đã tăng khoảng cách)
  \count@=\dimen@
  \divide\count@ by 24
  \multiply\count@ by 10
  \divide\count@ by \baselineskip

\ifnum\count@>1
  \advance\count@ by -1
  \dauchamK{\count@}[1][0.6mm]
\fi


  % ==== THÊM CÁC TRANG BỔ SUNG NẾU CÓ ====
  \@tempcnta=1
  \loop
    \ifnum\@tempcnta<#1
      \clearpage
      % số dòng của 1 trang đầy
      \count@=\textheight
      \divide\count@ by 24
      \multiply\count@ by 10
      \divide\count@ by \baselineskip
\advance\count@ by -2
\dauchamK{\count@}[1][0.6mm]

      \advance\@tempcnta by 1
  \repeat

  \clearpage
  \endgroup
}
\makeatother

