\NewDocumentCommand{\iconXanh}{O{circle} m}{%
	\tikz[baseline=-0.65ex]{
		\node[
			#1,
			fill=white,
			draw=mauxanhlaB!90!black,
			line width=0.55pt,
			text=mauxanhlaC,
			font=\scriptsize\bfseries,
			inner sep=1.35pt,
			minimum size=5.4mm,
			blur shadow={shadow blur steps=4,shadow xshift=.35pt,shadow yshift=-.35pt}
		]{#2};
	}%
}

% Icon số tròn: nền trắng, số xanh
\NewDocumentCommand{\soXanh}{m}{%
