% ----- Lệnh hiển thị tiêu đề chương -----
\newcommand{\tieudechuong}[2]{%
	\vspace*{0.1cm}
	\begin{tikzpicture}[baseline=(text.base)]
		% Mũi tên chính
		\fill[chapterColor] (-3,0) -- (2.5,0) -- (3,0.45) -- (2.5,0.9) -- (-3,0.9) -- (-2.5,0.45) -- cycle;
		% Chữ “CHƯƠNG”
		\node[white, font=\bfseries\LARGE] at (0,0.54) {#1};
		% Tên chương bên phải
		\node[
		anchor=west,
		font=\bfseries\LARGE,
		text=chapterColor,
		text width=0.65\textwidth, % 👈 Giới hạn chiều rộng vùng hiển thị
		align=left,                % 👈 Cho phép xuống dòng tự nhiên
		] (text) at (3.7,0.7) {#2};
		
	\end{tikzpicture}
	\vspace{0.1cm}
}

% ----- Lệnh \chuong -----
\newcommand{\chuong}[1]{%
	\refstepcounter{chapter}%
	\phantomsection
	\tieudechuong{CHƯƠNG \thechapter}{#1}%
	\addcontentsline{toc}{chapter}{\textcolor{red}{CHƯƠNG \thechapter. #1}}%
}


