\newcommand{\phantron}[3]{%
\begin{tikzpicture}[baseline=-2pt,scale=0.8]

\def\r{0.8}
\def\step{2.2}
\pgfmathsetmacro{\angle}{360/#3}

% ===== phần nguyên =====
\ifnum#1>0
\foreach \i in {0,...,\numexpr#1-1\relax}{
\begin{scope}[shift={(\i*\step,0)}]

% tô hết
\fill[pink!60] (0,0) circle (\r);

% chia giống mẫu
\foreach \j in {1,...,#3}{
\pgfmathsetmacro{\a}{90-(\j-1)*\angle}
\draw (0,0)--(\a:\r);
}

\draw[thick] (0,0) circle (\r);

\end{scope}
}
\fi

% ===== phần phân số =====
\ifnum#2>0
\begin{scope}[shift={(#1*\step,0)}]

\foreach \k in {1,...,#2}{
\pgfmathsetmacro{\start}{90-(\k-1)*\angle}
\pgfmathsetmacro{\end}{90-\k*\angle}
\fill[pink!60] (0,0)--(\start:\r) arc (\start:\end:\r)--cycle;
}

% vẽ chia
\foreach \j in {1,...,#3}{
\pgfmathsetmacro{\a}{90-(\j-1)*\angle}
\draw (0,0)--(\a:\r);
}

\draw[thick] (0,0) circle (\r);

\end{scope}
\fi

\end{tikzpicture}
}

%================ HÌNH HỌC TIKZ CHO ĐỀ TOÁN =================
\pgfdeclarelayer{bg}
\pgfdeclarelayer{top}
\pgfsetlayers{bg,main,top}
%----- STYLE CHUNG -----

\tikzset{
	seg/.style={blue!50!black,line width=0.9pt},
	segdash/.style={blue!50!black,line width=0.9pt,dashed},
	pt/.style={circle,draw=black,fill=red,inner sep=0.9pt},
	circlegeo/.style={green!60!black,line width=0.9pt},
	anglegeo/.style={green!50!black,line width=0.8pt}
}

%----- VẼ ĐOẠN THẲNG -----

\newcommand{\doanthang}[2]{
	\tkzDrawSegments[seg](#1,#2)
}

%----- VẼ TAM GIÁC -----

\newcommand{\tamgiac}[3]{
	\tkzDrawSegments[seg](#1,#2 #2,#3 #3,#1)
}

%----- VẼ ĐIỂM -----

\newcommand{\veDiem}[1]{
	\tkzDrawPoints[pt](#1)
}

%----- GHI TÊN ĐIỂM -----

\newcommand{\tenDiem}[2]{
	\tkzLabelPoints[#1,font=\small](#2)
}

%----- VẼ ĐƯỜNG TRÒN -----

\newcommand{\veDuongtron}[2]{
	\draw[circlegeo] (#1) circle (#2);
}

%----- ĐÁNH DẤU GÓC -----

\newcommand{\danhdaugoc}[3]{
	{\color{green!50!black}
	\tkzMarkAngle[size=0.7](#1,#2,#3)
	}
}

%----- GẠCH BẰNG NHAU -----

\newcommand{\bangnhauI}[2]{
	\tkzMarkSegment[mark=|](#1,#2)
}

\newcommand{\bangnhauII}[2]{
	\tkzMarkSegment[mark=||](#1,#2)
}

%----- PHÂN GIÁC -----

\newcommand{\phantgiac}[4]{
\tkzDefLine[bisector](#1,#2,#3)
\tkzGetPoint{#4}
}

%----- TRUNG ĐIỂM -----

\newcommand{\trungdiem}[3]{
\tkzDefMidPoint(#1,#2)
\tkzGetPoint{#3}
}

%===== ĐƯỜNG CAO TAM GIÁC =====

\newcommand{\duongcao}[4]{
\tkzDefPointBy[projection=onto #2--#3](#1)
\tkzGetPoint{#4}
\tkzDrawSegments[seg](#1,#4)
\tkzMarkRightAngle(#1,#4,#2)
}

%===== TRỰC TÂM =====

\newcommand{\tructam}[4]{
\tkzDefPointBy[projection=onto #2--#3](#1)
\tkzGetPoint{H#1}
\tkzDefPointBy[projection=onto #1--#3](#2)
\tkzGetPoint{H#2}
\tkzInterLL(#1,H#1)(#2,H#2)
\tkzGetPoint{#4}
}

%===== ĐƯỜNG KÍNH QUA ĐIỂM TRÊN ĐƯỜNG TRÒN =====

\newcommand{\duongkinh}[3]{
% #1: tâm
% #2: điểm trên đường tròn
% #3: điểm đối diện (sẽ sinh ra)

\tkzDefPointBy[symmetry=center #1](#2)
\tkzGetPoint{#3}

\tkzDrawSegments[seg](#2,#3)
}

\newcommand{\loigiai}[1]{%
\par\noindent\textbf{\textcolor{blue}{Lời giải: }}#1\par
}

