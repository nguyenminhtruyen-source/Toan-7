%==========VẼ ĐỒNG HỒ=====================
\newcommand{\donghokim}[2]{%
	\begin{tikzpicture}[scale=0.9]
		
		% mặt đồng hồ
		\draw[thick, fill=morongBG] (0,0) circle (2);
		
		% vạch phút
		\foreach \m in {0,6,...,354}{
			\draw[gray!60] ({90-\m}:1.85) -- ({90-\m}:2);
		}
		
		% vạch giờ lớn
		\foreach \h in {1,...,12}{
			\draw[line width=1pt] ({90-\h*30}:1.7) -- ({90-\h*30}:2);
		}
		
		% số giờ
		\foreach \h in {1,...,12}{
			\node at ({90-\h*30}:1.35) {\small\bfseries \h};
		}
		
		% kim phút
		\draw[line width=1.2pt, red] (0,0) -- ({90-#2*6}:1.15);
		
		% kim giờ
		\pgfmathsetmacro{\gocgio}{#1*30 + #2*0.5}
		\draw[line width=2pt, blue!80!black] (0,0) -- ({90-\gocgio}:0.75);
		
		% chốt giữa
		\fill[black] (0,0) circle (2.25pt);
		
	\end{tikzpicture}
}
