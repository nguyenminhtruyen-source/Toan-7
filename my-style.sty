\definecolor{redTitle}{HTML}{D30000}

\newcommand{\newbai}[1]{%
	\stepcounter{baiso}%
	\begin{center}
		\begin{tikzpicture}[line join=round, line cap=round]
			\coordinate (hex) at (0,0);
			
			\begin{scope}[shift={(-1.75,-0.59)}]
				\node[
				regular polygon,
				regular polygon sides=6,
				minimum size=1.3cm,
				fill=redTitle,
				rotate=30,
				inner sep=0pt,
				text=white,
				font=\bfseries\Large
				] (hexShape) {};
				\node[
				text=white,
				font=\bfseries\Large
				] at (hexShape.center) {\thebaiso};
			\end{scope}
			
			\node[anchor=east,text=redTitle,font=\bfseries\itshape\Large]
			at ($(hex.west)+(-2.65,-0.53)$) {Bài};
			
			\node[anchor=west,text=redTitle,font=\bfseries\large]
			at ($(hex.east)+(-0.5,-0.37)$) {#1};
			
			\fill[chapterTeal] ($(hex.west)+(-4.5,-0.95)$) circle (3pt);
			\draw[line width=2pt,chapterTeal]
			($(hex.west)+(-4.5,-0.95)$) -- ($(hex.west)+(-2.5,-0.95)$);
			
			\fill[chapterTeal] ($(hex.east)+(13,-0.95)$) circle (3pt);
			\draw[line width=2pt,chapterTeal]
			($(hex.east)+(-1,-0.95)$) -- ($(hex.east)+(13,-0.95)$);
			
			\draw[line width=2pt,chapterTeal]
			($(hex.south)+(-2.53,-0.939)$) --
			($(hex.south)+(-1.75,-1.41)$) --
			($(hex.south)+(-0.969,-0.941)$);
		\end{tikzpicture}
	\end{center}
	\vspace{0.5cm}
}

\newcommand{\newde}[1]{%
