\newcommand{\bai}[1]{%
	\refstepcounter{bai}%
	\phantomsection
	\begin{center}
		\begin{tikzpicture}[baseline=(text.base)]
			% Mũi tên nền
			\fill[baiColor] (-2,0) -- (2.5,0) -- (2,0.45) -- (2.5,0.9) -- (-2,0.9) -- (-1.5,0.45) -- cycle;
			% Tên bài và số
			\node[white, font=\bfseries\Large] at (0.1,0.5)
			{\faScroll\; BÀI~\thebai};
			% Tên bài (phía phải)
			\node[anchor=west, font=\bfseries\Large, text=baiColor] (text)
			at (3,0.5) {#1};
		\end{tikzpicture}
	\end{center}
	\vspace{0.09cm}
	\addcontentsline{toc}{section}{\textcolor{baicolor}{Bài \thebai. #1}}%
}

