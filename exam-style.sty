% ===============================================
% MACRO: \TieuDeThi — TIÊU ĐỀ ĐỀ THI TỐI GIẢN CHO TH, THCS, ...
% ===============================================
% Cách dùng:
%   \TieuDeThi{Lớp}{Thời gian}{Số mã nhỏ}
%   - Lớp:       VD "4"  hoặc "8A1", ...
%   - Thời gian: VD "60" (phút)
%   - Số mã nhỏ: VD "1", "2", ..., "20" (tùy số mã)
% -----------------------------------------------
\NewDocumentCommand{\TieuDeThi}{m m m}{%
    % Tên trường mặc định: TRƯỜNG TH-THCS ...., chỉnh sửa tại đây nếu muốn thay đổi
    \def\defaultschool{TRƯỜNG TH-THCS\,\ldots\,}
    % Tính năm hiện tại và năm kế tiếp
    \def\curryear{\the\year}
    \pgfmathtruncatemacro{\nextyear}{\year + 1}
    \noindent
    \begin{minipage}[t]{0.48\linewidth}
        \centering
        \textbf{\defaultschool}\\[0.3em]
        \fboxsep=1pt
        \colorbox{white}{\setlength\fboxsep{0.5pt}\fbox{\strut\ \textbf{ĐỀ THAM KHẢO}\ }}
    \end{minipage}%
    \hfill
    \begin{minipage}[t]{0.48\linewidth}
        \centering
        \textbf{ĐỀ KIỂM TRA}\\
        \textbf{NĂM HỌC \curryear--\nextyear}\\
        \textbf{Môn: Toán #1}\\
        \textit{(Thời gian làm bài: #2 phút)}
    \end{minipage}

    \vspace{0.8em}

    \noindent
    \textbf{Họ và tên thí sinh:} \makebox[7cm]{\dotfill}
    \hfill
    \textbf{Lớp:} \makebox[2cm]{\dotfill}
    \hfill
    % Mã đề thi = #1*100 + #3
    \pgfmathtruncatemacro{\madevalue}{#1*100 + #3}%
    \textbf{Mã đề: \madevalue}

    \vspace{0.5em}
    {\color{mainblue}\hrule}
    \vspace{1em}
}

