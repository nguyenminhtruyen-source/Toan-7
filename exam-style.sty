% ----- Mục cơ bản (gạch trái, có trong Mục lục) -----
\newcommand{\muc}[1]{%
	\refstepcounter{muc}%  % Tăng số mục
	\phantomsection        % Tạo anchor cho hyperref
	\setcounter{cau}{0}    % Reset lại số câu khi qua mục mới
	\addcontentsline{toc}{subsubsection}{%
		\protect\numberline{\themuc}#1}%  % ✅ Ghi vào mục lục (hiển thị số và nội dung)
