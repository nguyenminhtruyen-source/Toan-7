%% ========== XIV. BIỂU ĐỒ & HƯỚNG DẪN SỬ DỤNG ============
%% =========================================================
%%
%% Các môi trường biểu đồ được thiết kế bằng TikZ + PGFPlots.
%% Có thể dùng để minh họa số liệu thống kê, bài toán thực tế, v.v.
%%
%% ---------------------------------------------------------
%% 1️⃣ BIỂU ĐỒ TRÒN — \myPatternPie
%% ---------------------------------------------------------
%% Cách dùng:
%%   \begin{myPatternPie}{<dữ liệu>}
	%%   \end{myPatternPie}
%%
%% Ví dụ:
%%{\centering
	%%	\myPatternPie[2]{
		%%		25/Toán/dots,
		%%		20/Văn/horizontal lines,
		%%		30/Tiếng Anh/crosshatch,
		%%		25/Tin học/vertical lines}
	%%	\par}}
	%%
	%% Mỗi cặp {tỷ lệ / nhãn} — tổng tỷ lệ = 100.
	%% ---------------------------------------------------------
	
	\pgfplotsset{compat=1.18}
	\usetikzlibrary{patterns.meta}
	
	% ==== 7 PATTERN ĐỊNH SẴN DÙNG CHO BIỂU ĐỒ TRÒN ====
	\def\patternone{north east lines}
	\def\patterntwo{dots}
	\def\patternthree{grid}
	\def\patternfour{crosshatch}
	\def\patternfive{horizontal lines}  
	\def\patternsix{north west lines}
	\def\patternseven{crosshatch} 
	
\newcount\patternpieN
\newcommand{\myPatternPie}[2][3]{%
	\begingroup
	\def\R{#1}% bán kính
	\patternpieN=0
	% Đếm tổng số phần tử để xác định tổng số dòng chú thích
	\foreach \entry in {#2} { \global\advance\patternpieN by 1 }%
	% Bắt đầu từ 12 giờ (90 độ)
	\def\startangle{90}%
	
	\begin{tikzpicture}[font=\footnotesize]
		% ==== Vẽ các phần (miếng) của biểu đồ ====
		\foreach[count=\i from 1] \p/\name/\pat in {#2} {
			\pgfmathtruncatemacro{\k}{mod(\i-1,6)}% Lấy dư để lặp lại 6 màu/pattern
			
			% Logic chọn Pattern và Màu sắc dựa trên \k
			\ifcase\k
			\def\mypat{north east lines}
			\colorlet{myline}{blue!50}
			\or
			\def\mypat{dots}
			\colorlet{myline}{red!50}
			\or
			\def\mypat{grid}
			\colorlet{myline}{green!50}
			\or
			\def\mypat{crosshatch}
			\colorlet{myline}{purple!50}
			\or
			\def\mypat{horizontal lines}
			\colorlet{myline}{orange!50}
			\else
			\def\mypat{north west lines}
			\colorlet{myline}{teal!50}
			\fi
			
			% Nếu người dùng nhập pattern cụ thể trong danh sách, hãy ghi đè
			\ifx\pat\empty
			% Giữ nguyên \mypat mặc định từ \ifcase
			\else
			\def\mypat{\pat}% Dùng pattern người dùng nhập
			\fi
			
			% Tính góc độ rộng của miếng
			\pgfmathsetmacro{\delta}{\p*3.6}
			% endangle tính trừ đi delta để vẽ XUÔI chiều kim đồng hồ từ 12h
			\pgfmathsetmacro{\endangle}{\startangle - \delta}
			
			% Vẽ miếng (tô màu pattern với màu sắc đã chọn)
			\filldraw[pattern=\mypat, pattern color=myline!80, draw=black!50]
			(0,0) -- (\startangle:\R) arc (\startangle:\endangle:\R) -- cycle;
			
			% Hiển thị % bên trong
			\pgfmathsetmacro{\midangle}{\startangle - 0.5*\delta}
			% Dùng màu chữ là màu của nét vẽ miếng đó cho đồng bộ
			\node at (\midangle:0.6*\R) {\normalsize\bfseries\color{myline!10!black}\p\%};
			
			% Cập nhật góc bắt đầu mới cho miếng tiếp theo
			\xdef\startangle{\endangle}
		}
		% ==== Vẽ vòng tròn ngoài ====
		\draw[thick] (0,0) circle (\R);
		
		% ==== CHÚ THÍCH (LEGEND) ====
		\begin{scope}[xshift=1.3*\R cm] % dịch sang phải
			\def\s{0.5} % kích thước ô vuông chú thích
			\pgfmathsetmacro{\gap}{0.75}   % khoảng cách dọc giữa các dòng
			
			\node[anchor=west,text depth=0pt] at (0, 1.2) {\textbf{Chú thích:}};
			
			% Lặp lại danh sách để vẽ chú thích, dùng cùng logic chọn màu
			\foreach[count=\j from 1] \p/\name/\pat in {#2} {
				\pgfmathtruncatemacro{\k}{mod(\j-1,6)}
				
				% Lặp lại logic chọn màu giống như khi vẽ miếng
				\ifcase\k
				\def\mypatLegend{north east lines}
				\colorlet{myLegendColor}{blue!50}
				\or
				\def\mypatLegend{dots}
				\colorlet{myLegendColor}{red!50}
				\or
				\def\mypatLegend{grid}
				\colorlet{myLegendColor}{green!50}
				\or
				\def\mypatLegend{crosshatch}
				\colorlet{myLegendColor}{purple!50}
				\or
				\def\mypatLegend{horizontal lines}
				\colorlet{myLegendColor}{orange!50}
				\else
				\def\mypatLegend{north west lines}
				\colorlet{myLegendColor}{teal!50}
				\fi
				
				% Ghi đè pattern chú thích nếu người dùng nhập cụ thể
				\ifx\pat\empty
				% Giữ nguyên \mypatLegend
				\else
				\def\mypatLegend{\pat}%
				\fi
				
				% Tính toán vị trí dọc cho dòng chú thích
				\pgfmathsetmacro{\y}{-(\j-1)*\gap}
				
				% Vẽ ô vuông chú thích
				\filldraw[pattern=\mypatLegend, pattern color=myLegendColor!80, draw=black]
				(0,\y) rectangle ++(\s,\s);
				% Nhãn chú thích
				\node[anchor=west,text depth=0pt] at (\s+0.2,\y+0.5*\s) {\name};
			}
		\end{scope}
	\end{tikzpicture}
	\endgroup
}

%% ---------------------------------------------------------
%% 2️⃣ BIỂU ĐỒ CỘT — \bieudocot
%% ---------------------------------------------------------
%% Cách dùng:
%%   \bieudocot{Danh mục}{Giá trị1,Giá trị2,...}
%%   \bieudocot{Lớp}{35,40,28,50}
%%
%% Sẽ tự động sinh cột với độ cao tương ứng, nhãn bên dưới.
%% ---------------------------------------------------------

\newcommand{\bieudocot}[2][1]{%
\begin{tikzpicture}[x=1.5cm,y=0.7cm,scale=#1]
	% ==== TRỤC TUNG ====
	\draw[->] (0,0) -- (0,9);
	\node[rotate=0,anchor=east,scale=0.7] at (2,9.5) {\small Số học sinh};
	% ==== VẠCH CHIA ====
	\foreach \y in {0,1,...,8}
	\draw (-0.1,\y) -- (0.1,\y) node[left=4pt,scale=0.75]{\small \y};
	\draw (0,0) -- (7.5,0);
	
	% ==== VẼ CÁC CỘT ====
	\foreach \x/\h/\lbl in {#2}{%
		\draw[fill=blue,draw=black] (\x,0) rectangle ++(0.8,\h);
		\node[above,scale=0.75] at (\x+0.4,\h) {\small \h};
		\node[below,scale=0.6,text depth=1.5pt] at (\x+0.4,0) {\text{\lbl}};
	}
\end{tikzpicture}%
}

%% ---------------------------------------------------------
%% 3️⃣ BIỂU ĐỒ CỘT KÉP — \bieudocotkep
%% ---------------------------------------------------------
%% Dùng để so sánh 2 nhóm dữ liệu (VD: Nam / Nữ, Trước / Sau,...)
%%
%% Cách dùng:
%%   \bieudocotkep{Danh mục}{Dữ liệu1}{Dữ liệu2}{Tên1}{Tên2}
%%
%% Ví dụ:
%%{\centering
%%	\bieudocotkep{Bóng đá}{12}{10}{Bóng rổ}{5}{6}{Cầu lông}{8}{7}
%%	\par}}
%%
%% ---------------------------------------------------------

\newcommand{\bieudocotkep}[9]{%
\begin{center}
\begin{tikzpicture}[scale=0.6,font=\small]
	% ==== TRỤC TUNG ====
	\draw[->] (0,0) -- (0,6.5) node[above right] {Số học sinh};
	\foreach \y in {0,2,4,6,8,10,12}{
		\draw (-0.08,\y/2) -- (0.08,\y/2);
		\node[left] at (-0.12,\y/2) {\y};
	}
	% ==== ĐƯỜNG ĐÁY ====
	\draw[thick] (0,0) -- (7.8,0);
	% ==== KHOẢNG CÁCH & CHIỀU RỘNG CỘT ====
	\def\xsep{2.2}
	\def\w{0.35}
	
	% --- Nhóm 1 ---
	\draw[fill=blue] (1*\xsep-\w,0) rectangle ++(2*\w,#2/2);
	\node[above,font=\scriptsize] at (1*\xsep,#2/2) {#2};
	
	\draw[draw=black,fill=white] (1*\xsep+\w,0) rectangle ++(2*\w,#3/2);
	\node[above,font=\scriptsize] at (1*\xsep+2*\w,#3/2) {#3};
	
	% --- Nhóm 2 ---
	\draw[fill=blue] (2*\xsep-\w,0) rectangle ++(2*\w,#5/2);
	\node[above,font=\scriptsize] at (2*\xsep,#5/2) {#5};
	
	\draw[draw=black,fill=white] (2*\xsep+\w,0) rectangle ++(2*\w,#6/2);
	\node[above,font=\scriptsize] at (2*\xsep+2*\w,#6/2) {#6};
	
	% --- Nhóm 3 ---
	\draw[fill=blue] (3*\xsep-\w,0) rectangle ++(2*\w,#8/2);
	\node[above,font=\scriptsize] at (3*\xsep,#8/2) {#8};
	
	\draw[draw=black,fill=white] (3*\xsep+\w,0) rectangle ++(2*\w,#9/2);
	\node[above,font=\scriptsize] at (3*\xsep+2*\w,#9/2) {#9};
	
	% ==== NHÃN NHÓM ====
	\node[below,scale=0.85] at (1*\xsep+1*\w,0) {\text{#1}};
	\node[below,scale=0.85] at (2*\xsep+1*\w,0) {\text{#4}};
	\node[below,scale=0.85] at (3*\xsep+1*\w,0) {\text{#7}};
	
	% ==== CHÚ THÍCH ====
	\draw[fill=blue] (7.2,5.8) rectangle ++(0.35,0.35);
	\node[right] at (7.6,6.0) {Nam};
	\draw[draw=black,fill=white] (7.2,5.0) rectangle ++(0.35,0.35);
	\node[right] at (7.6,5.2) {Nữ};
\end{tikzpicture}
\end{center}
}

