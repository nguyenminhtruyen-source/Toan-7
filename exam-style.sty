\NewDocumentCommand{\dauchamE}{m}{%
	\par\noindent
	\begingroup
	
	% ===== ĐO CHIỀU CAO 1 DÒNG CHẤM THẬT =====
	\setbox0=\vbox{\dauchamK{1}[1][0.6mm]}
	\dimen@=\ht0
	\advance\dimen@ by \dp0   % tổng chiều cao thật
	\newdimen\lineht
	\lineht=2.1\baselineskip 
	
	% ===== PHẦN CÒN LẠI TRANG =====
	\dimen@=\pagegoal
	\advance\dimen@ by -\pagetotal
	%\advance\dimen@ by -\footskip
	
	% trừ an toàn nhỏ (rất ít thôi)
	\advance\dimen@ by -0.3\baselineskip
	
	% ===== TÍNH SỐ DÒNG =====
	\count@=\dimen@
	\divide\count@ by \lineht
	
	\ifnum\count@>0
	\dauchamK{\count@}[1][0.6mm]
	\fi
	
	% ===== TRANG BỔ SUNG =====
	\@tempcnta=1
	\loop
	\ifnum\@tempcnta<#1
	\clearpage
	
	\dimen@=\textheight
	\advance\dimen@ by -\footskip
	
	\count@=\dimen@
	\divide\count@ by \lineht
	
	\dauchamK{\count@}[1][0.6mm]
	
	\advance\@tempcnta by 1
	\repeat
	
	\clearpage
	\endgroup
}
