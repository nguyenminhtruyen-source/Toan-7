% ===== DẤU CHẤM CÓ ĐƯỜNG VẠCH GIỮA =====
\NewDocumentCommand{\dauchamC}{m O{1} O{0.5mm}}{%
	% #1 = số dòng; #2 = số cột-con; #3 = gap (kích thước, có đơn vị)
	\vspace{0.9em} \foreach \i in {1,...,#1}{%
		\par \noindent
		\begin{tikzpicture}[baseline=(base),inner sep=0pt,outer sep=0pt]
			\coordinate (base) at (0,0);
			% đặt bounding box chính xác bằng \linewidth để tránh overfull
			\path[use as bounding box] (0,-1.2ex) rectangle (\linewidth,1.2ex);
			% chiều rộng mỗi cột-con (kết quả là length)
			\pgfmathsetlengthmacro{\colw}{\dimexpr\linewidth/#2\relax}
			\pgfmathsetlengthmacro{\gap}{#3}
			% epsilon để tránh stroke tràn ra ngoài bounding box
			\pgfmathsetlengthmacro{\eps}{0.2pt}
			\foreach \j in {1,...,#2}{%
				\pgfmathsetlengthmacro{\L}{(\j-1)*\colw}
				\pgfmathsetlengthmacro{\R}{\j*\colw}
				\ifnum\j=1
				\pgfmathsetlengthmacro{\start}{\L}
				\else
				\pgfmathsetlengthmacro{\start}{\L + 0.5*\gap}
				\fi
				\ifnum\j=#2
				\pgfmathsetlengthmacro{\endd}{\R}
				\else
				\pgfmathsetlengthmacro{\endd}{\R - 0.5*\gap}
				\fi
				% điều chỉnh nhẹ phần cuối để tránh stroke tràn
				\pgfmathsetlengthmacro{\startadj}{\start}
				\pgfmathsetlengthmacro{\endadj}{\endd - \eps}
				\draw[dotted, line width=0.4pt] (\startadj,0) -- (\endadj,0);
				\ifnum\j<#2
				\pgfmathsetlengthmacro{\xmid}{\j*\colw}
				\draw[line width=0.3pt] (\xmid,1.5ex) -- (\xmid,-0.5ex);
				\fi
			}% end foreach j
		\end{tikzpicture}\par \vspace{0.7em}
	}% end foreach i
}% end command

% ===== DẤU CHẤM KHÔNG ĐƯỜNG VẠCH GIỮA =====
\usepackage{xfp} % để tính toán số thực chính xác hơn

\NewDocumentCommand{\dauchamK}{m O{1} O{0.5mm}}{%
	\vspace{0.9em} \foreach \i in {1,...,#1}{%
		
		\par \noindent 
		\begin{tikzpicture}[baseline=(base),inner sep=0pt,outer sep=0pt]
			\coordinate (base) at (0,0);
			\path[use as bounding box] (0,-1.2ex) rectangle (\linewidth,1.2ex);
			
			% --- tính toán độ rộng mỗi cột bằng calc + fpeval ---
			\pgfmathsetmacro{\ratio}{1/#2}
			\pgfmathsetlengthmacro{\colw}{\dimexpr \ratio\linewidth\relax}
			\pgfmathsetlengthmacro{\gap}{#3}
			\pgfmathsetlengthmacro{\eps}{0.2pt}
			
			\foreach \j in {1,...,#2}{%
				\pgfmathsetlengthmacro{\L}{(\j-1)*\colw}
				\pgfmathsetlengthmacro{\R}{\j*\colw}
				\ifnum\j=1
				\pgfmathsetlengthmacro{\start}{\L}
				\else
				\pgfmathsetlengthmacro{\start}{\L + 0.5*\gap}
				\fi
				\ifnum\j=#2
				\pgfmathsetlengthmacro{\endd}{\R}
				\else
				\pgfmathsetlengthmacro{\endd}{\R - 0.5*\gap}
				\fi
				\pgfmathsetlengthmacro{\startadj}{\start}
				\pgfmathsetlengthmacro{\endadj}{\endd - \eps}
				\draw[dotted, line width=0.4pt] (\startadj,0) -- (\endadj,0);
			}
		\end{tikzpicture}\par \vspace{0.7em}
	}
}

