	\begin{tikzpicture}[baseline=(muc.base)]
		\fill[mucColor!80!black] (0,0) rectangle (0.25,0.9);
		\node (muc)[anchor=west,text=mucColor!90!black,font=\bfseries]
		at (0.35,0.45) {\themuc.~#1};
	\end{tikzpicture}%
	\vspace{0.25em}\par
}


\newcommand{\chapterScript}[1]{%
	{\fontfamily{qpl}\selectfont\fontsize{24}{26}\selectfont #1}%
}
\newcommand{\chapstripes}{%
	\fill[chapterTeal] (0,0) --
	(0.35,0.7) --
	(0.85,0.7) --
	(0.5,0) -- cycle;
	\begin{scope}[xshift=0.75cm]
		\fill[chapterTealLight] (0,0) --
		(0.35,0.7) --
		(0.85,0.7) --
		(0.5,0) -- cycle;
	\end{scope}
	\begin{scope}[xshift=1.5cm]
		\fill[chapterTealLight] (0,0) --
		(0.35,0.7) --
		(0.85,0.7) --
		(0.5,0) -- cycle;
	\end{scope}
}
\definecolor{chapterTeal}{HTML}{007C7A}
\definecolor{chapterTealLight}{HTML}{A7D5D3}
\newcommand{\DrawChapterHeader}[2]{%
	\begin{tikzpicture}[baseline]
		
		% độ xéo đuôi hình bình hành
		\def\Slant{0.35}
		
		% hình bình hành kéo dài qua trái 3cm
		\fill[chapterTeal]
		(-3,0.1) --
		(6.45,0.1) --
		({6.45+\Slant},0.81) --
		(-3,0.81) -- cycle;
		
		% 3 sọc xiên bên phải
		\begin{scope}[shift={(6.7,0.1)}]
			\chapstripes
		\end{scope}
		
		% chữ "Chương ..."
		\node[
		anchor=east,
		text=chapterTeal
		] at (14,0.6)
		{\chapterScript{#1}};
		
		% chữ tiêu đề
		\node[
		anchor=east,
		font=\bfseries\LARGE,
		text=chapterTeal
		] at (14,-0.9)
		{#2};
		
	\end{tikzpicture}
}
