% =====================================================
% MACRO: \bieudoquattrong
% -----------------------------------------------------
% Công dụng:
%   Vẽ biểu đồ hình quạt tròn có:
%   - Pattern màu nhạt
%   - Viền màu sinh động
%   - Ô chú thích bên phải
%   - Dòng chấm để học sinh tự điền tên
%----------------------------------------
% Cú pháp sử dụng:
%   \bieudoquattrong[<bán kính>]{<danh sách phần trăm>}
%   \begin{center}
	%       \myPatternPieExam[3]{30,20,25,25}
	%   \end{center}
% Nghĩa là:
%   - Bán kính = 3 cm
%   - 4 phần: 30%, 20%, 25%, 25%
%-----------------------------------------------
% Tùy chỉnh nhanh:
%   \gap   : khoảng cách giữa các dòng chú thích
%   \s     : kích thước ô vuông
%   xshift : khoảng cách legend tới biểu đồ
% =====================================================
\newcommand{\bieudoquattrong}[2][3]{%
	\begingroup
	\def\R{#1}
	\def\startangle{0}
	
	% Đếm số phần
	\newcount\patternpieN
	\patternpieN=0
	\foreach \p in {#2} {\advance\patternpieN by 1}
	
	\begin{tikzpicture}
		
		% ===== VẼ BIỂU ĐỒ =====
		\foreach[count=\i from 1] \p in {#2} {
			
			\pgfmathtruncatemacro{\k}{mod(\i-1,6)}
			\ifcase\k
			\def\mypat{north east lines}
			\colorlet{myline}{blue!60!black}
			\or
			\def\mypat{dots}
			\colorlet{myline}{red!70!black}
			\or
			\def\mypat{grid}
			\colorlet{myline}{green!60!black}
			\or
			\def\mypat{crosshatch}
			\colorlet{myline}{purple!70!black}
			\or
			\def\mypat{horizontal lines}
			\colorlet{myline}{orange!80!black}
			\else
			\def\mypat{north west lines}
			\colorlet{myline}{teal!70!black}
			\fi
			
			\pgfmathsetmacro{\delta}{\p*3.6}
			\pgfmathsetmacro{\endangle}{\startangle+\delta}
			
			\filldraw[
			pattern=\mypat,
			pattern color=myline!40,
			draw=myline,
			line width=0.8pt
			]
			(0,0) -- (\startangle:\R)
			arc (\startangle:\endangle:\R) -- cycle;
			
			\xdef\startangle{\endangle}
		}
		
		\draw[line width=1.2pt] (0,0) circle (\R);
		
		% ===== CHÚ THÍCH (FIX CHUẨN) =====
		
		% Đếm số phần bằng pgfmath (ổn định hơn count)
		\pgfmathsetmacro{\N}{0}
		\foreach \p in {#2} {
			\pgfmathparse{\N+1}
			\xdef\N{\pgfmathresult}
		}
		
		\begin{scope}[xshift=2.2*\R cm] % đẩy xa hơn
			
			\def\s{0.5}
			\pgfmathsetmacro{\gap}{1.2}
			\pgfmathsetmacro{\starty}{(\N-1)/2*\gap}
			
			\node[anchor=west] at (0,\starty + \gap + 0.3)
			{\textbf{Chú thích:}};
			
			\foreach \j in {1,...,\N} {
				
				\pgfmathtruncatemacro{\k}{mod(\j-1,6)}
				
				\ifcase\k
				\def\mypatLegend{north east lines}
				\colorlet{myline}{blue!60!black}
				\or
				\def\mypatLegend{dots}
				\colorlet{myline}{red!70!black}
				\or
				\def\mypatLegend{grid}
				\colorlet{myline}{green!60!black}
				\or
				\def\mypatLegend{crosshatch}
				\colorlet{myline}{purple!70!black}
				\or
				\def\mypatLegend{horizontal lines}
				\colorlet{myline}{orange!80!black}
				\else
				\def\mypatLegend{north west lines}
				\colorlet{myline}{teal!70!black}
				\fi
				
				\pgfmathsetmacro{\y}{\starty - (\j-1)*\gap}
				
				% Ô pattern
				\filldraw[
				pattern=\mypatLegend,
				pattern color=myline!40,
				draw=myline
				]
				(0,\y) rectangle ++(\s,\s);
				
				% Dòng chấm
				\draw[dotted, thick]
				(\s+0.4,\y+0.5*\s) -- ++(3.5,0);
			}
			
		\end{scope}
		
	\end{tikzpicture}
	\endgroup
}


